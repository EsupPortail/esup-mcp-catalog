# Clé API Grist dédiée à ce connecteur. Ne jamais la committer.
GRIST_API_KEY=replace-with-your-grist-api-key

# Requis : mcp-server-grist pointe par défaut vers https://docs.getgrist.com/api
# (le SaaS public GetGrist), pas vers La Suite numérique. Sans cette valeur,
# une clé valide pour grist.numerique.gouv.fr est rejetée comme invalide.
GRIST_API_URL=https://grist.numerique.gouv.fr/api
